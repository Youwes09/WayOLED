# Maintainer: Youwes09 <yuvi.shen@outlook.com>

pkgname=wayoled
pkgver=0.1.0
pkgrel=1
pkgdesc='Display protection daemon for wlroots-based Wayland compositors'
arch=('x86_64' 'aarch64')
url='https://github.com/Youwes09/WayOLED'
license=('MIT')
depends=('wayland')
makedepends=('meson' 'wayland-protocols')
backup=('etc/wayoled/schedule.conf.example')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "WayOLED-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "WayOLED-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
